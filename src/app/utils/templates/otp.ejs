<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>OTP Verification</title>

  <style>
    body {
      margin: 0;
      padding: 0;
      background: #f4f6f8;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .container {
      max-width: 500px;
      margin: 50px auto;
      background: #ffffff;
      border-radius: 12px;
      padding: 30px 25px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
      text-align: center;
    }

    .logo {
      font-size: 22px;
      font-weight: bold;
      color: #4f46e5;
      margin-bottom: 10px;
    }

    h2 {
      color: #333;
      margin-bottom: 10px;
    }

    p {
      color: #555;
      font-size: 14px;
      margin: 8px 0;
    }

    .otp-box {
      margin: 25px 0;
      padding: 15px;
      background: #f1f5ff;
      border: 2px dashed #4f46e5;
      border-radius: 10px;
      display: inline-block;
    }

    .otp {
      font-size: 28px;
      letter-spacing: 6px;
      font-weight: bold;
      color: #4f46e5;
    }

    .warning {
      font-size: 13px;
      color: #888;
      margin-top: 10px;
    }

    .footer {
      margin-top: 25px;
      font-size: 12px;
      color: #aaa;
    }

    .footer span {
      color: #4f46e5;
      font-weight: 500;
    }

    @media (max-width: 500px) {
      .container {
        margin: 20px;
        padding: 20px;
      }

      .otp {
        font-size: 22px;
        letter-spacing: 4px;
      }
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="logo">🔐 Secure OTP</div>

    <h2>Hello <%= name %>,</h2>

    <p>Your One-Time Password (OTP) is:</p>

    <div class="otp-box">
      <div class="otp"><%= otp %></div>
    </div>

    <p class="warning">This code is valid for 2 minutes.</p>

    <p class="warning">Do not share this code with anyone.</p>

    <div class="footer">
      © <span>Digital Wallet</span> — All rights reserved
    </div>
  </div>

</body>
</html>