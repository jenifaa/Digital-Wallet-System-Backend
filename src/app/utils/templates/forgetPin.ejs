<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reset wallet PIN</title>
  </head>
  <body style="font-family: Arial, sans-serif; line-height: 1.5; color: #111;">
    <div style="max-width: 640px; margin: 0 auto; padding: 24px;">
      <h2 style="margin: 0 0 12px;">Reset your wallet PIN</h2>
      <p style="margin: 0 0 12px;">Hi <%= name || "there" %>,</p>
      <p style="margin: 0 0 16px;">
        We received a request to reset your wallet PIN. Click the button below to set a new PIN.
        This link expires in <strong>10 minutes</strong>.
      </p>
      <p style="margin: 0 0 20px;">
        <a
          href="<%= resetUILink %>"
          style="display: inline-block; padding: 10px 14px; background: #111; color: #fff; text-decoration: none; border-radius: 6px;"
        >
          Reset PIN
        </a>
      </p>
      <p style="margin: 0; font-size: 12px; color: #666;">
        If you didn’t request this, you can safely ignore this email.
      </p>
    </div>
  </body>
</html>

